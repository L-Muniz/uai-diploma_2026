@startuml
title cu__CU07_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "DECISION" as DECISION {
  *ID_DECISION PK
  ID_INFORME FK (nulo)
  ID_USUARIO FK
  ID_PUNTO_VERDE FK (nulo)
  TIPO
  DESCRIPCION
  FECHA
}
entity "TARIFA_COMISION" as TARIFA {
  *ID_TARIFA PK
  ID_DECISION FK (nulo)
  CATEGORIA
  PORCENTAJE
  VIGENTE_DESDE
}
entity "INFORME_GESTION" as INFORME {
  *ID_INFORME PK
  ID_USUARIO FK
  TIPO
  PERIODO
  FECHA_GENERACION
}
USUARIO ||--o{ INFORME
INFORME ||--o{ DECISION
DECISION ||--o{ TARIFA
USUARIO ||--o{ DECISION
@enduml
