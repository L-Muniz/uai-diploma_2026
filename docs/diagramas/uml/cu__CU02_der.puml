@startuml
title cu__CU02_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "DECLARACION_MATERIAL" as DECLARACION {
  *ID_DECLARACION PK
  ID_USUARIO FK
  ID_MATERIAL FK
  CANTIDAD
  FECHA
  ESTADO
}
entity "ACOPIO" as ACOPIO {
  *ID_ACOPIO PK
  ID_DECLARACION FK (nulo)
  ID_PUNTO_VERDE FK
  ID_MATERIAL FK
  PESO_KG
  FECHA_RECEPCION
  ESTADO
}
entity "PUNTO_VERDE" as PUNTO_VERDE {
  *ID_PUNTO_VERDE PK
  NOMBRE
  DIRECCION
  LATITUD
  LONGITUD
  HORARIO
  ACTIVO
}
entity "MATERIAL" as MATERIAL {
  *ID_MATERIAL PK
  NOMBRE
  CATEGORIA
  UNIDAD_MEDIDA
}
entity "PUNTO_VERDE_MATERIAL" as PVM {
  *ID_PUNTO_VERDE PK, FK
  *ID_MATERIAL PK, FK
  ACEPTADO
}
entity "CUENTA_ECOPUNTOS" as CUENTA {
  *ID_CUENTA PK
  ID_USUARIO FK UNIQUE
  SALDO
  NIVEL
}
entity "MOVIMIENTO_ECOPUNTOS" as MOVIMIENTO {
  *ID_MOVIMIENTO PK
  ID_CUENTA FK
  TIPO
  PUNTOS
  FECHA
  MOTIVO
}
USUARIO ||--o{ DECLARACION
DECLARACION }o--|| MATERIAL
DECLARACION ||--o| ACOPIO
PUNTO_VERDE ||--o{ ACOPIO
MATERIAL ||--o{ ACOPIO
PUNTO_VERDE ||--o{ PVM
MATERIAL ||--o{ PVM
USUARIO ||--|| CUENTA
CUENTA ||--o{ MOVIMIENTO
@enduml
