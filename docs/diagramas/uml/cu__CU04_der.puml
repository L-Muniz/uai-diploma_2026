@startuml
title cu__CU04_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "INFORME_GESTION" as INFORME {
  *ID_INFORME PK
  ID_USUARIO FK
  TIPO
  PERIODO
  FECHA_GENERACION
}
entity "ACOPIO" as ACOPIO {
  *ID_ACOPIO PK
  ID_DECLARACION FK (nulo)
  ID_PUNTO_VERDE FK
  ID_MATERIAL FK
  PESO_KG
  FECHA_RECEPCION
  ESTADO
}
entity "PUNTO_VERDE" as PUNTO_VERDE {
  *ID_PUNTO_VERDE PK
  NOMBRE
  DIRECCION
  LATITUD
  LONGITUD
  HORARIO
  ACTIVO
}
entity "MATERIAL" as MATERIAL {
  *ID_MATERIAL PK
  NOMBRE
  CATEGORIA
  UNIDAD_MEDIDA
}
entity "ORDEN_VENTA" as ORDEN {
  *ID_ORDEN PK
  ID_COMPRADOR FK
  ID_VENDEDOR FK
  FECHA
  ESTADO
  MONTO_BRUTO
  DIRECCION_ENVIO
}
entity "COMISION" as COMISION {
  *ID_COMISION PK
  ID_ORDEN FK
  PORCENTAJE
  MONTO
  FECHA
}
entity "CANJE" as CANJE {
  *ID_CANJE PK
  ID_USUARIO FK
  ID_CUENTA FK
  ID_BENEFICIO FK
  PUNTOS_USADOS
  FECHA
  ESTADO
}
entity "BENEFICIO" as BENEFICIO {
  *ID_BENEFICIO PK
  TIPO
  DESCRIPCION
  PUNTOS_REQUERIDOS
  COSTO_EMPRESA
  ACTIVO
}
PUNTO_VERDE ||--o{ ACOPIO
MATERIAL ||--o{ ACOPIO
USUARIO ||--o{ CANJE
BENEFICIO ||--o{ CANJE
USUARIO ||--o{ INFORME
USUARIO ||--o{ ORDEN
USUARIO ||--o{ ORDEN
ORDEN ||--|| COMISION
@enduml
