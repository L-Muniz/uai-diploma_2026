@startuml
title cu__CU06_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "PUNTO_VERDE" as PUNTO_VERDE {
  *ID_PUNTO_VERDE PK
  NOMBRE
  DIRECCION
  LATITUD
  LONGITUD
  HORARIO
  ACTIVO
}
entity "MATERIAL" as MATERIAL {
  *ID_MATERIAL PK
  NOMBRE
  CATEGORIA
  UNIDAD_MEDIDA
}
entity "PUNTO_VERDE_MATERIAL" as PVM {
  *ID_PUNTO_VERDE PK, FK
  *ID_MATERIAL PK, FK
  ACEPTADO
}
entity "DECISION" as DECISION {
  *ID_DECISION PK
  ID_INFORME FK (nulo)
  ID_USUARIO FK
  ID_PUNTO_VERDE FK (nulo)
  TIPO
  DESCRIPCION
  FECHA
}
entity "INFORME_GESTION" as INFORME {
  *ID_INFORME PK
  ID_USUARIO FK
  TIPO
  PERIODO
  FECHA_GENERACION
}
PUNTO_VERDE ||--o{ PVM
MATERIAL ||--o{ PVM
USUARIO ||--o{ INFORME
INFORME ||--o{ DECISION
DECISION }o--o| PUNTO_VERDE
USUARIO ||--o{ DECISION
@enduml
