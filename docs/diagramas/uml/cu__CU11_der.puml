@startuml
title cu__CU11_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "VERIFICACION_VENDEDOR" as VERIFICACION {
  *ID_VERIFICACION PK
  ID_USUARIO FK
  FECHA
  ESTADO
  DOCUMENTO_REF
}
entity "PRODUCTO" as PRODUCTO {
  *ID_PRODUCTO PK
  ID_VENDEDOR FK
  ID_TARIFA FK (nulo)
  NOMBRE
  DESCRIPCION
  CATEGORIA
  PRECIO
  STOCK
  ESTADO
}
entity "TARIFA_COMISION" as TARIFA {
  *ID_TARIFA PK
  ID_DECISION FK (nulo)
  CATEGORIA
  PORCENTAJE
  VIGENTE_DESDE
}
USUARIO ||--o{ VERIFICACION
USUARIO ||--o{ PRODUCTO
TARIFA ||--o{ PRODUCTO
@enduml
