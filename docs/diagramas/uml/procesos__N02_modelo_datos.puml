@startuml
title procesos__N02_modelo_datos
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "DATOS_USUARIO" as DATOS_USUARIO {
  *ID_USUARIO PK, FK
  FECHA_NACIMIENTO
  LATITUD
  LONGITUD
  LOCALIDAD
}
entity "VERIFICACION_VENDEDOR" as VERIFICACION {
  *ID_VERIFICACION PK
  ID_USUARIO FK
  FECHA
  ESTADO
  DOCUMENTO_REF
}
entity "PRODUCTO" as PRODUCTO {
  *ID_PRODUCTO PK
  ID_VENDEDOR FK
  ID_TARIFA FK (nulo)
  NOMBRE
  DESCRIPCION
  CATEGORIA
  PRECIO
  STOCK
  ESTADO
}
entity "TARIFA_COMISION" as TARIFA {
  *ID_TARIFA PK
  ID_DECISION FK (nulo)
  CATEGORIA
  PORCENTAJE
  VIGENTE_DESDE
}
entity "ORDEN_VENTA" as ORDEN {
  *ID_ORDEN PK
  ID_COMPRADOR FK
  ID_VENDEDOR FK
  FECHA
  ESTADO
  MONTO_BRUTO
  DIRECCION_ENVIO
}
entity "ORDEN_DETALLE" as ITEM {
  *ID_ORDEN PK, FK
  *ID_PRODUCTO PK, FK
  CANTIDAD
  PRECIO_UNITARIO
}
entity "PAGO" as PAGO {
  *ID_PAGO PK
  ID_ORDEN FK
  REFERENCIA_PASARELA
  MONTO
  ESTADO
  FECHA
}
entity "COMISION" as COMISION {
  *ID_COMISION PK
  ID_ORDEN FK
  PORCENTAJE
  MONTO
  FECHA
}
entity "LIQUIDACION_VENDEDOR" as LIQUIDACION {
  *ID_LIQUIDACION PK
  ID_ORDEN FK UNIQUE
  MONTO_NETO
  ESTADO
  FECHA_DISPONIBLE
  FECHA_PAGO
}
entity "RECLAMO" as RECLAMO {
  *ID_RECLAMO PK
  ID_ORDEN FK
  ID_USUARIO FK
  MOTIVO
  ESTADO
  FECHA
}
USUARIO ||--o{ VERIFICACION
USUARIO ||--o{ PRODUCTO
USUARIO ||--o{ ORDEN
USUARIO ||--o{ ORDEN
ORDEN ||--|{ ITEM
PRODUCTO ||--o{ ITEM
ORDEN ||--|{ PAGO
ORDEN ||--|| COMISION
ORDEN ||--|| LIQUIDACION
ORDEN ||--o{ RECLAMO
USUARIO ||--o{ RECLAMO
TARIFA ||--o{ PRODUCTO
USUARIO ||--o| DATOS_USUARIO
@enduml
