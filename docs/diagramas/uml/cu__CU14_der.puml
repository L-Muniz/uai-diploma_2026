@startuml
title cu__CU14_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "ORDEN_VENTA" as ORDEN {
  *ID_ORDEN PK
  ID_COMPRADOR FK
  ID_VENDEDOR FK
  FECHA
  ESTADO
  MONTO_BRUTO
  DIRECCION_ENVIO
}
entity "ORDEN_DETALLE" as ITEM {
  *ID_ORDEN PK, FK
  *ID_PRODUCTO PK, FK
  CANTIDAD
  PRECIO_UNITARIO
}
USUARIO ||--o{ ORDEN
USUARIO ||--o{ ORDEN
ORDEN ||--|{ ITEM
@enduml
