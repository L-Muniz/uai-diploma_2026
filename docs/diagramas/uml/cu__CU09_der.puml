@startuml
title cu__CU09_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "DATOS_USUARIO" as DATOS_USUARIO {
  *ID_USUARIO PK, FK
  FECHA_NACIMIENTO
  LATITUD
  LONGITUD
  LOCALIDAD
}
entity "VERIFICACION_VENDEDOR" as VERIFICACION {
  *ID_VERIFICACION PK
  ID_USUARIO FK
  FECHA
  ESTADO
  DOCUMENTO_REF
}
USUARIO ||--o{ VERIFICACION
USUARIO ||--o| DATOS_USUARIO
@enduml
