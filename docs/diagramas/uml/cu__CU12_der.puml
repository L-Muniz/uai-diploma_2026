@startuml
title cu__CU12_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "PRODUCTO" as PRODUCTO {
  *ID_PRODUCTO PK
  ID_VENDEDOR FK
  ID_TARIFA FK (nulo)
  NOMBRE
  DESCRIPCION
  CATEGORIA
  PRECIO
  STOCK
  ESTADO
}
USUARIO ||--o{ PRODUCTO
@enduml
