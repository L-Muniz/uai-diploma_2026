@startuml
title cu__CU03_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "CUENTA_ECOPUNTOS" as CUENTA {
  *ID_CUENTA PK
  ID_USUARIO FK UNIQUE
  SALDO
  NIVEL
}
entity "MOVIMIENTO_ECOPUNTOS" as MOVIMIENTO {
  *ID_MOVIMIENTO PK
  ID_CUENTA FK
  TIPO
  PUNTOS
  FECHA
  MOTIVO
}
entity "CANJE" as CANJE {
  *ID_CANJE PK
  ID_USUARIO FK
  ID_CUENTA FK
  ID_BENEFICIO FK
  PUNTOS_USADOS
  FECHA
  ESTADO
}
entity "BENEFICIO" as BENEFICIO {
  *ID_BENEFICIO PK
  TIPO
  DESCRIPCION
  PUNTOS_REQUERIDOS
  COSTO_EMPRESA
  ACTIVO
}
USUARIO ||--|| CUENTA
CUENTA ||--o{ MOVIMIENTO
USUARIO ||--o{ CANJE
BENEFICIO ||--o{ CANJE
CUENTA ||--o{ CANJE
@enduml
