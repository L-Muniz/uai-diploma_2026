@startuml
title cu__CU13_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "PRODUCTO" as PRODUCTO {
  *ID_PRODUCTO PK
  ID_VENDEDOR FK
  ID_TARIFA FK (nulo)
  NOMBRE
  DESCRIPCION
  CATEGORIA
  PRECIO
  STOCK
  ESTADO
}
entity "ORDEN_VENTA" as ORDEN {
  *ID_ORDEN PK
  ID_COMPRADOR FK
  ID_VENDEDOR FK
  FECHA
  ESTADO
  MONTO_BRUTO
  DIRECCION_ENVIO
}
entity "ORDEN_DETALLE" as ITEM {
  *ID_ORDEN PK, FK
  *ID_PRODUCTO PK, FK
  CANTIDAD
  PRECIO_UNITARIO
}
entity "PAGO" as PAGO {
  *ID_PAGO PK
  ID_ORDEN FK
  REFERENCIA_PASARELA
  MONTO
  ESTADO
  FECHA
}
entity "COMISION" as COMISION {
  *ID_COMISION PK
  ID_ORDEN FK
  PORCENTAJE
  MONTO
  FECHA
}
entity "LIQUIDACION_VENDEDOR" as LIQUIDACION {
  *ID_LIQUIDACION PK
  ID_ORDEN FK UNIQUE
  MONTO_NETO
  ESTADO
  FECHA_DISPONIBLE
  FECHA_PAGO
}
USUARIO ||--o{ PRODUCTO
USUARIO ||--o{ ORDEN
USUARIO ||--o{ ORDEN
ORDEN ||--|{ ITEM
PRODUCTO ||--o{ ITEM
ORDEN ||--|{ PAGO
ORDEN ||--|| COMISION
ORDEN ||--|| LIQUIDACION
@enduml
