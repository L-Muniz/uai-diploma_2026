@startuml
skinparam classAttributeIconSize 0
title cu__CU02_clases
class "BE_USUARIO" as USUARIO {
  +ID: int
  +Username: string
  +HashedPassword: string
  +Bloqueado: bool
  +DVHorizontal: int
  +Rol: string
}
class "BE_DeclaracionMaterial" as DECLARACION {
  +ID: int
  +IDUsuario: int
  +Material: BE_Material
  +Cantidad: decimal
  +Fecha: DateTime
  +Estado: string
}
class "BE_Acopio" as ACOPIO {
  +ID: int
  +IDDeclaracion: int?
  +PuntoVerde: BE_PuntoVerde
  +Material: BE_Material
  +PesoKg: decimal
  +FechaRecepcion: DateTime
  +Estado: string
}
class "BE_PuntoVerde" as PUNTO_VERDE {
  +ID: int
  +Nombre: string
  +Direccion: string
  +Latitud: decimal?
  +Longitud: decimal?
  +Horario: string
  +Activo: bool
  +MaterialesAceptados: List<BE_Material>
}
class "BE_Material" as MATERIAL {
  +ID: int
  +Nombre: string
  +Categoria: string
  +UnidadMedida: string
}
class "BE_CuentaEcoPuntos" as CUENTA {
  +ID: int
  +IDUsuario: int
  +Saldo: int
  +Nivel: int
}
class "BE_MovimientoEcoPuntos" as MOVIMIENTO {
  +ID: int
  +IDCuenta: int
  +Tipo: string
  +Puntos: int
  +Fecha: DateTime
  +Motivo: string
}
USUARIO "1" -- "0..*" DECLARACION
DECLARACION "0..*" -- "1" MATERIAL
DECLARACION "1" -- "0..1" ACOPIO
PUNTO_VERDE "1" -- "0..*" ACOPIO
MATERIAL "1" -- "0..*" ACOPIO
PUNTO_VERDE "0..*" -- "0..*" MATERIAL
USUARIO "1" -- "1" CUENTA
CUENTA "1" -- "0..*" MOVIMIENTO
USUARIO "0..*" -- "0..*" MATERIAL
@enduml
