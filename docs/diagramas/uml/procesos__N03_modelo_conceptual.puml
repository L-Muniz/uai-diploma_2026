@startuml
skinparam classAttributeIconSize 0
title procesos__N03_modelo_conceptual
class "BE_USUARIO" as USUARIO {
  +ID: int
  +Username: string
  +HashedPassword: string
  +Bloqueado: bool
  +DVHorizontal: int
  +Rol: string
}
class "BE_DatosUsuario" as DATOS_USUARIO {
  +IDUsuario: int
  +FechaNacimiento: DateTime?
  +Latitud: decimal?
  +Longitud: decimal?
  +Localidad: string
}
class "BE_DeclaracionMaterial" as DECLARACION {
  +ID: int
  +IDUsuario: int
  +Material: BE_Material
  +Cantidad: decimal
  +Fecha: DateTime
  +Estado: string
}
class "BE_Material" as MATERIAL {
  +ID: int
  +Nombre: string
  +Categoria: string
  +UnidadMedida: string
}
class "BE_Recomendacion" as RECOMENDACION {
  +ID: int
  +Declaracion: BE_DeclaracionMaterial
  +Guia: BE_GuiaReutilizacion
  +PuntoVerde: BE_PuntoVerde
  +TipoOpcionElegida: string
  +FechaGeneracion: DateTime
}
class "BE_GuiaReutilizacion" as GUIA {
  +ID: int
  +Material: BE_Material
  +Titulo: string
  +Pasos: string
  +Dificultad: string
}
class "BE_PuntoVerde" as PUNTO_VERDE {
  +ID: int
  +Nombre: string
  +Direccion: string
  +Latitud: decimal?
  +Longitud: decimal?
  +Horario: string
  +Activo: bool
  +MaterialesAceptados: List<BE_Material>
}
class "BE_CuentaEcoPuntos" as CUENTA {
  +ID: int
  +IDUsuario: int
  +Saldo: int
  +Nivel: int
}
class "BE_MovimientoEcoPuntos" as MOVIMIENTO {
  +ID: int
  +IDCuenta: int
  +Tipo: string
  +Puntos: int
  +Fecha: DateTime
  +Motivo: string
}
class "BE_Acopio" as ACOPIO {
  +ID: int
  +IDDeclaracion: int?
  +PuntoVerde: BE_PuntoVerde
  +Material: BE_Material
  +PesoKg: decimal
  +FechaRecepcion: DateTime
  +Estado: string
}
class "BE_Canje" as CANJE {
  +ID: int
  +IDUsuario: int
  +Beneficio: BE_Beneficio
  +PuntosUsados: int
  +Fecha: DateTime
  +Estado: string
}
class "BE_Beneficio" as BENEFICIO {
  +ID: int
  +Tipo: string
  +Descripcion: string
  +PuntosRequeridos: int
  +CostoEmpresa: decimal
  +Activo: bool
}
USUARIO "1" -- "0..*" DECLARACION
DECLARACION "0..*" -- "1" MATERIAL
DECLARACION "1" -- "0..1" RECOMENDACION
RECOMENDACION "0..*" -- "0..1" GUIA
RECOMENDACION "0..*" -- "0..1" PUNTO_VERDE
DECLARACION "1" -- "0..1" ACOPIO
PUNTO_VERDE "1" -- "0..*" ACOPIO
MATERIAL "1" -- "0..*" ACOPIO
PUNTO_VERDE "0..*" -- "0..*" MATERIAL
USUARIO "1" -- "1" CUENTA
CUENTA "1" -- "0..*" MOVIMIENTO
USUARIO "1" -- "0..*" CANJE
BENEFICIO "1" -- "0..*" CANJE
CUENTA "1" -- "0..*" CANJE
MATERIAL "1" -- "0..*" GUIA
USUARIO "1" -- "0..1" DATOS_USUARIO
USUARIO "0..*" -- "0..*" MATERIAL
@enduml
