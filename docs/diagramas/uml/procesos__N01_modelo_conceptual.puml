@startuml
skinparam classAttributeIconSize 0
title procesos__N01_modelo_conceptual
class "BE_USUARIO" as USUARIO {
  +ID: int
  +Username: string
  +HashedPassword: string
  +Bloqueado: bool
  +DVHorizontal: int
  +Rol: string
}
class "BE_InformeGestion" as INFORME {
  +ID: int
  +IDUsuario: int
  +Tipo: string
  +Periodo: string
  +FechaGeneracion: DateTime
}
class "BE_InformeIndicadores" as IND {
  +Version: string
  +Periodo: string
  +FechaGeneracion: DateTime
  +Generado: string
  +Indicadores: List<BE_IndicadorItem>
}
class "BE_Acopio" as ACOPIO {
  +ID: int
  +IDDeclaracion: int?
  +PuntoVerde: BE_PuntoVerde
  +Material: BE_Material
  +PesoKg: decimal
  +FechaRecepcion: DateTime
  +Estado: string
}
class "BE_PuntoVerde" as PUNTO_VERDE {
  +ID: int
  +Nombre: string
  +Direccion: string
  +Latitud: decimal?
  +Longitud: decimal?
  +Horario: string
  +Activo: bool
  +MaterialesAceptados: List<BE_Material>
}
class "BE_Material" as MATERIAL {
  +ID: int
  +Nombre: string
  +Categoria: string
  +UnidadMedida: string
}
class "BE_OrdenVenta" as ORDEN {
  +ID: int
  +IDComprador: int
  +IDVendedor: int
  +Fecha: DateTime
  +Estado: string
  +MontoBruto: decimal
  +DireccionEnvio: string
  +Items: List<BE_ItemOrden>
}
class "BE_Comision" as COMISION {
  +ID: int
  +IDOrden: int
  +Porcentaje: decimal
  +Monto: decimal
  +Fecha: DateTime
}
class "BE_Canje" as CANJE {
  +ID: int
  +IDUsuario: int
  +Beneficio: BE_Beneficio
  +PuntosUsados: int
  +Fecha: DateTime
  +Estado: string
}
class "BE_Beneficio" as BENEFICIO {
  +ID: int
  +Tipo: string
  +Descripcion: string
  +PuntosRequeridos: int
  +CostoEmpresa: decimal
  +Activo: bool
}
class "BE_Decision" as DECISION {
  +ID: int
  +IDInforme: int?
  +IDUsuario: int
  +IDPuntoVerde: int?
  +Tipo: string
  +Descripcion: string
  +Fecha: DateTime
}
class "BE_TarifaComision" as TARIFA {
  +ID: int
  +IDDecision: int?
  +Categoria: string
  +Porcentaje: decimal
  +VigenteDesde: DateTime
}
class "BE_TablaConversion" as CONVERSION {
  +ID: int
  +IDDecision: int?
  +Material: BE_Material
  +PuntosPorKg: decimal
  +VigenteDesde: DateTime
}
PUNTO_VERDE "1" -- "0..*" ACOPIO
MATERIAL "1" -- "0..*" ACOPIO
PUNTO_VERDE "0..*" -- "0..*" MATERIAL
USUARIO "1" -- "0..*" CANJE
BENEFICIO "1" -- "0..*" CANJE
USUARIO "1" -- "0..*" INFORME
INFORME "1" -- "0..*" ACOPIO
INFORME "1" -- "0..*" DECISION
DECISION "1" -- "0..*" TARIFA
DECISION "0..*" -- "0..1" PUNTO_VERDE
DECISION "1" -- "0..*" CONVERSION
MATERIAL "1" -- "0..*" CONVERSION
USUARIO "1" -- "0..*" DECISION
USUARIO "1" -- "0..*" ORDEN
USUARIO "1" -- "0..*" ORDEN
ORDEN "1" -- "1" COMISION
USUARIO "0..*" -- "0..*" MATERIAL
INFORME "1" -- "0..1" IND
@enduml
