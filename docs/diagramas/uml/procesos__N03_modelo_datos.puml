@startuml
title procesos__N03_modelo_datos
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "DATOS_USUARIO" as DATOS_USUARIO {
  *ID_USUARIO PK, FK
  FECHA_NACIMIENTO
  LATITUD
  LONGITUD
  LOCALIDAD
}
entity "DECLARACION_MATERIAL" as DECLARACION {
  *ID_DECLARACION PK
  ID_USUARIO FK
  ID_MATERIAL FK
  CANTIDAD
  FECHA
  ESTADO
}
entity "MATERIAL" as MATERIAL {
  *ID_MATERIAL PK
  NOMBRE
  CATEGORIA
  UNIDAD_MEDIDA
}
entity "RECOMENDACION" as RECOMENDACION {
  *ID_RECOMENDACION PK
  ID_DECLARACION FK UNIQUE
  ID_GUIA FK (nulo)
  ID_PUNTO_VERDE FK (nulo)
  TIPO_OPCION_ELEGIDA
  FECHA_GENERACION
}
entity "GUIA_REUTILIZACION" as GUIA {
  *ID_GUIA PK
  ID_MATERIAL FK
  TITULO
  PASOS
  DIFICULTAD
}
entity "PUNTO_VERDE" as PUNTO_VERDE {
  *ID_PUNTO_VERDE PK
  NOMBRE
  DIRECCION
  LATITUD
  LONGITUD
  HORARIO
  ACTIVO
}
entity "CUENTA_ECOPUNTOS" as CUENTA {
  *ID_CUENTA PK
  ID_USUARIO FK UNIQUE
  SALDO
  NIVEL
}
entity "MOVIMIENTO_ECOPUNTOS" as MOVIMIENTO {
  *ID_MOVIMIENTO PK
  ID_CUENTA FK
  TIPO
  PUNTOS
  FECHA
  MOTIVO
}
entity "ACOPIO" as ACOPIO {
  *ID_ACOPIO PK
  ID_DECLARACION FK (nulo)
  ID_PUNTO_VERDE FK
  ID_MATERIAL FK
  PESO_KG
  FECHA_RECEPCION
  ESTADO
}
entity "PUNTO_VERDE_MATERIAL" as PVM {
  *ID_PUNTO_VERDE PK, FK
  *ID_MATERIAL PK, FK
  ACEPTADO
}
entity "CANJE" as CANJE {
  *ID_CANJE PK
  ID_USUARIO FK
  ID_CUENTA FK
  ID_BENEFICIO FK
  PUNTOS_USADOS
  FECHA
  ESTADO
}
entity "BENEFICIO" as BENEFICIO {
  *ID_BENEFICIO PK
  TIPO
  DESCRIPCION
  PUNTOS_REQUERIDOS
  COSTO_EMPRESA
  ACTIVO
}
USUARIO ||--o{ DECLARACION
DECLARACION }o--|| MATERIAL
DECLARACION ||--o| RECOMENDACION
RECOMENDACION }o--o| GUIA
RECOMENDACION }o--o| PUNTO_VERDE
DECLARACION ||--o| ACOPIO
PUNTO_VERDE ||--o{ ACOPIO
MATERIAL ||--o{ ACOPIO
PUNTO_VERDE ||--o{ PVM
MATERIAL ||--o{ PVM
USUARIO ||--|| CUENTA
CUENTA ||--o{ MOVIMIENTO
USUARIO ||--o{ CANJE
BENEFICIO ||--o{ CANJE
CUENTA ||--o{ CANJE
MATERIAL ||--o{ GUIA
USUARIO ||--o| DATOS_USUARIO
@enduml
