@startuml
title der_tecnico
entity "BITACORA" as BITACORA {
  *ID_BITACORA PK
  ID_USUARIO
  DESCRIPCION
  FECHA
}
entity "CAMBIOS_ENTIDAD" as CAMBIOS {
  *ID_CAMBIO PK
  TIPO_ENTIDAD
  ID_ENTIDAD
  NOMBRE_ATRIBUTO
  VALOR_ANTERIOR
  VALOR_NUEVO
  ID_USUARIO_MODIFICO
  FECHA_CAMBIO
  DESCRIPCION
}
entity "DIGITO_VERIFICADOR_VERTICAL" as DVV {
  *ID_DVV PK
  ID_ENTIDAD
  TIPO_ENTIDAD
  DV_USERNAME
  DV_PASSWORD
  DV_BLOQUEADO
  FECHA_CREACION
}
entity "EXCLUSION_PERMISO_ROL" as EXCLUSION {
  *ID PK
  ID_ROL
  ID_PERMISO
  FECHA_CREACION
}
entity "IDIOMA" as IDIOMA {
  *ID_IDIOMA PK
  CODIGO
  NOMBRE
  ACTIVO
}
entity "PERFIL" as PERFIL {
  *ID_PERFIL PK
  NOMBRE
  DESCRIPCION
  ID_PERFIL_PADRE
}
entity "PERFIL_PERMISO" as PERFIL_PERMISO {
  *ID_PERFIL PK
  *ID_PERMISO PK
}
entity "PERMISO" as PERMISO {
  *ID_PERMISO PK
  CODIGO
  NOMBRE
  DESCRIPCION
  ES_COMPUESTO
}
entity "PERMISO_COMPONENTE" as PERMISO_COMPONENTE {
  *ID PK
  ID_PERMISO_PADRE
  ID_PERMISO_HIJO
  FECHA_CREACION
}
entity "ROL" as ROL {
  *ID_ROL PK
  NOMBRE
  DESCRIPCION
  ACTIVO
  ID_ROL_PADRE
}
entity "ROL_PERFIL" as ROL_PERFIL {
  ID_ROL
  ID_PERFIL
}
entity "ROL_PERMISO" as ROL_PERMISO {
  *ID_ROL PK
  *ID_PERMISO PK
}
entity "SNAPSHOTS" as SNAPSHOTS {
  *ID_SNAPSHOT PK
  NOMBRE
  DESCRIPCION
  CONTENIDO
  FECHA_CREACION
  ID_USUARIO
}
entity "TRADUCCION" as TRADUCCION {
  *ID_TRADUCCION PK
  CLAVE
  ID_IDIOMA
  VALOR
}
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "USUARIO_ROL" as USUARIO_ROL {
  *ID_USUARIO PK
  *ID_ROL PK
}
PERMISO ||--o{ EXCLUSION
ROL ||--o{ EXCLUSION
PERFIL ||--o{ PERFIL_PERMISO
PERMISO ||--o{ PERFIL_PERMISO
PERMISO ||--o{ PERMISO_COMPONENTE
PERMISO ||--o{ PERMISO_COMPONENTE
PERMISO ||--o{ ROL_PERMISO
ROL ||--o{ ROL_PERMISO
USUARIO ||--o{ SNAPSHOTS
@enduml
