@startuml
skinparam classAttributeIconSize 0
title CU01 - Clases afectadas
class "BE_USUARIO" as BE_USUARIO <<BE>> {
  +Username: string
  +HashedPassword: string
  +ID: int
  +Bloqueado: bool
  +DVHorizontal: int
  +Rol: string
  --
  +ToString(): string
}
class "BE_DatosUsuario" as BE_DatosUsuario <<BE>> {
  +IDUsuario: int
  +FechaNacimiento: DateTime?
  +Latitud: decimal?
  +Longitud: decimal?
  +Localidad: string
}
class "BE_DeclaracionMaterial" as BE_DeclaracionMaterial <<BE>> {
  +ID: int
  +IDUsuario: int
  +Cantidad: decimal
  +Fecha: DateTime
  +Estado: string
}
class "BE_Material" as BE_Material <<BE>> {
  +ID: int
  +Nombre: string
  +Categoria: string
  +UnidadMedida: string
  --
  +ToString(): string
}
class "BE_Recomendacion" as BE_Recomendacion <<BE>> {
  +ID: int
  +TipoOpcionElegida: string
  +FechaGeneracion: DateTime
}
class "BE_GuiaReutilizacion" as BE_GuiaReutilizacion <<BE>> {
  +ID: int
  +Titulo: string
  +Pasos: string
  +Dificultad: string
}
class "BE_PuntoVerde" as BE_PuntoVerde <<BE>> {
  +ID: int
  +Nombre: string
  +Direccion: string
  +Latitud: decimal?
  +Longitud: decimal?
  +Horario: string
  +Activo: bool
  --
  +ToString(): string
}
class "BE_CuentaEcoPuntos" as BE_CuentaEcoPuntos <<BE>> {
  +ID: int
  +IDUsuario: int
  +Saldo: int
  +Nivel: int
}
class "BE_MovimientoEcoPuntos" as BE_MovimientoEcoPuntos <<BE>> {
  +ID: int
  +IDCuenta: int
  +Tipo: string
  +Puntos: int
  +Fecha: DateTime
  +Motivo: string
}
BE_DeclaracionMaterial "1" o-- "0..1" BE_Material : Material
BE_Recomendacion "1" o-- "0..1" BE_DeclaracionMaterial : Declaracion
BE_Recomendacion "1" o-- "0..1" BE_GuiaReutilizacion : Guia
BE_Recomendacion "1" o-- "0..1" BE_PuntoVerde : PuntoVerde
BE_GuiaReutilizacion "1" o-- "0..1" BE_Material : Material
BE_PuntoVerde "1" o-- "0..*" BE_Material : MaterialesAceptados
@enduml
