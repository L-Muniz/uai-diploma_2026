@startuml
skinparam classAttributeIconSize 0
title CU13 - Clases afectadas
class "BE_USUARIO" as BE_USUARIO <<BE>> {
  +Username: string
  +HashedPassword: string
  +ID: int
  +Bloqueado: bool
  +DVHorizontal: int
  +Rol: string
  --
  +ToString(): string
}
class "BE_Producto" as BE_Producto <<BE>> {
  +ID: int
  +IDVendedor: int
  +IDTarifa: int?
  +Nombre: string
  +Descripcion: string
  +Categoria: string
  +Precio: decimal
  +Stock: int
  +Estado: string
  --
  +ToString(): string
}
class "BE_OrdenVenta" as BE_OrdenVenta <<BE>> {
  +ID: int
  +IDComprador: int
  +IDVendedor: int
  +Fecha: DateTime
  +Estado: string
  +MontoBruto: decimal
  +DireccionEnvio: string
}
class "BE_ItemOrden" as BE_ItemOrden <<BE>> {
  +Cantidad: int
  +PrecioUnitario: decimal
}
class "BE_Pago" as BE_Pago <<BE>> {
  +ID: int
  +IDOrden: int
  +ReferenciaPasarela: string
  +Monto: decimal
  +Estado: string
  +Fecha: DateTime
}
class "BE_Comision" as BE_Comision <<BE>> {
  +ID: int
  +IDOrden: int
  +Porcentaje: decimal
  +Monto: decimal
  +Fecha: DateTime
}
class "BE_LiquidacionVendedor" as BE_LiquidacionVendedor <<BE>> {
  +ID: int
  +IDOrden: int
  +MontoNeto: decimal
  +Estado: string
  +FechaDisponible: DateTime?
  +FechaPago: DateTime?
}
BE_OrdenVenta "1" *-- "0..*" BE_ItemOrden : Items
BE_ItemOrden "0..*" --> "1" BE_Producto : Producto
@enduml
