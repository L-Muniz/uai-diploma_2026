@startuml
skinparam classAttributeIconSize 0
title cu__CU13_clases
class "BE_USUARIO" as USUARIO {
  +ID: int
  +Username: string
  +HashedPassword: string
  +Bloqueado: bool
  +DVHorizontal: int
  +Rol: string
}
class "BE_Producto" as PRODUCTO {
  +ID: int
  +IDVendedor: int
  +IDTarifa: int?
  +Nombre: string
  +Descripcion: string
  +Categoria: string
  +Precio: decimal
  +Stock: int
  +Estado: string
}
class "BE_OrdenVenta" as ORDEN {
  +ID: int
  +IDComprador: int
  +IDVendedor: int
  +Fecha: DateTime
  +Estado: string
  +MontoBruto: decimal
  +DireccionEnvio: string
  +Items: List<BE_ItemOrden>
}
class "BE_ItemOrden" as ITEM {
  +Producto: BE_Producto
  +Cantidad: int
  +PrecioUnitario: decimal
}
class "BE_Pago" as PAGO {
  +ID: int
  +IDOrden: int
  +ReferenciaPasarela: string
  +Monto: decimal
  +Estado: string
  +Fecha: DateTime
}
class "BE_Comision" as COMISION {
  +ID: int
  +IDOrden: int
  +Porcentaje: decimal
  +Monto: decimal
  +Fecha: DateTime
}
class "BE_LiquidacionVendedor" as LIQUIDACION {
  +ID: int
  +IDOrden: int
  +MontoNeto: decimal
  +Estado: string
  +FechaDisponible: DateTime?
  +FechaPago: DateTime?
}
USUARIO "1" -- "0..*" PRODUCTO
USUARIO "1" -- "0..*" ORDEN
USUARIO "1" -- "0..*" ORDEN
ORDEN "1" *-- "1..*" ITEM
PRODUCTO "1" -- "0..*" ITEM
ORDEN "1" -- "1..*" PAGO
ORDEN "1" -- "1" COMISION
ORDEN "1" -- "1" LIQUIDACION
@enduml
