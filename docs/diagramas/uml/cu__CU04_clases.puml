@startuml
skinparam classAttributeIconSize 0
title CU04 - Clases afectadas
class "BE_USUARIO" as BE_USUARIO <<BE>> {
  +Username: string
  +HashedPassword: string
  +ID: int
  +Bloqueado: bool
  +DVHorizontal: int
  +Rol: string
  --
  +ToString(): string
}
class "BE_InformeGestion" as BE_InformeGestion <<BE>> {
  +ID: int
  +IDUsuario: int
  +Tipo: string
  +Periodo: string
  +FechaGeneracion: DateTime
}
class "BE_InformeIndicadores" as BE_InformeIndicadores <<BE>> {
  +Version: string
  +Periodo: string
  +FechaGeneracion: DateTime
  +Generado: string
}
class "BE_Acopio" as BE_Acopio <<BE>> {
  +ID: int
  +IDDeclaracion: int?
  +PesoKg: decimal
  +FechaRecepcion: DateTime
  +Estado: string
}
class "BE_PuntoVerde" as BE_PuntoVerde <<BE>> {
  +ID: int
  +Nombre: string
  +Direccion: string
  +Latitud: decimal?
  +Longitud: decimal?
  +Horario: string
  +Activo: bool
  --
  +ToString(): string
}
class "BE_Material" as BE_Material <<BE>> {
  +ID: int
  +Nombre: string
  +Categoria: string
  +UnidadMedida: string
  --
  +ToString(): string
}
class "BE_OrdenVenta" as BE_OrdenVenta <<BE>> {
  +ID: int
  +IDComprador: int
  +IDVendedor: int
  +Fecha: DateTime
  +Estado: string
  +MontoBruto: decimal
  +DireccionEnvio: string
}
class "BE_Comision" as BE_Comision <<BE>> {
  +ID: int
  +IDOrden: int
  +Porcentaje: decimal
  +Monto: decimal
  +Fecha: DateTime
}
class "BE_Canje" as BE_Canje <<BE>> {
  +ID: int
  +IDUsuario: int
  +PuntosUsados: int
  +Fecha: DateTime
  +Estado: string
}
class "BE_Beneficio" as BE_Beneficio <<BE>> {
  +ID: int
  +Tipo: string
  +Descripcion: string
  +PuntosRequeridos: int
  +CostoEmpresa: decimal
  +Activo: bool
  --
  +ToString(): string
}
BE_Acopio "0..*" --> "1" BE_PuntoVerde : PuntoVerde
BE_Acopio "0..*" --> "1" BE_Material : Material
BE_PuntoVerde "1" o-- "0..*" BE_Material : MaterialesAceptados
BE_Canje "0..*" --> "1" BE_Beneficio : Beneficio
@enduml
