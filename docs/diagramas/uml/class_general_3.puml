@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
title Capa BE (parte 3 de 7)
class "BE_GuiaReutilizacion" as BE_GuiaReutilizacion <<BE>> {
  +ID: int
  +Titulo: string
  +Pasos: string
  +Dificultad: string
}
class "BE_Idioma" as BE_Idioma <<BE>> {
  +Codigo: string
  +Nombre: string
  --
  +ToString(): string
}
class "BE_IndicadorItem" as BE_IndicadorItem <<BE>> {
  +Nombre: string
  +Valor: string
}
class "BE_InformeGestion" as BE_InformeGestion <<BE>> {
  +ID: int
  +IDUsuario: int
  +Tipo: string
  +Periodo: string
  +FechaGeneracion: DateTime
}
class "BE_InformeIndicadores" as BE_InformeIndicadores <<BE>> {
  +Version: string
  +Periodo: string
  +FechaGeneracion: DateTime
  +Generado: string
}
class "BE_ItemOrden" as BE_ItemOrden <<BE>> {
  +Cantidad: int
  +PrecioUnitario: decimal
}
class "BE_Material" as BE_Material <<BE>> {
  +ID: int
  +Nombre: string
  +Categoria: string
  +UnidadMedida: string
  --
  +ToString(): string
}
class "BE_Producto" as BE_Producto <<BE>> {
  +ID: int
  +IDVendedor: int
  +IDTarifa: int?
  +Nombre: string
  +Descripcion: string
  +Categoria: string
  +Precio: decimal
  +Stock: int
  +Estado: string
  --
  +ToString(): string
}
BE_GuiaReutilizacion -[hidden]down- BE_Idioma
BE_Idioma -[hidden]down- BE_IndicadorItem
BE_IndicadorItem -[hidden]down- BE_InformeGestion
BE_InformeIndicadores -[hidden]down- BE_ItemOrden
BE_ItemOrden -[hidden]down- BE_Material
BE_Material -[hidden]down- BE_Producto
BE_GuiaReutilizacion -[hidden]right- BE_InformeIndicadores
BE_GuiaReutilizacion "0..*" --> "1" BE_Material : Material
BE_InformeIndicadores "1" *-- "0..*" BE_IndicadorItem : Indicadores
BE_ItemOrden "0..*" --> "1" BE_Producto : Producto
@enduml
