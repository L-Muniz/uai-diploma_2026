@startuml
title cu__CU08_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "DECISION" as DECISION {
  *ID_DECISION PK
  ID_INFORME FK (nulo)
  ID_USUARIO FK
  ID_PUNTO_VERDE FK (nulo)
  TIPO
  DESCRIPCION
  FECHA
}
entity "TABLA_CONVERSION" as CONVERSION {
  *ID_CONVERSION PK
  ID_DECISION FK (nulo)
  ID_MATERIAL FK
  PUNTOS_POR_KG
  VIGENTE_DESDE
}
entity "MATERIAL" as MATERIAL {
  *ID_MATERIAL PK
  NOMBRE
  CATEGORIA
  UNIDAD_MEDIDA
}
DECISION ||--o{ CONVERSION
MATERIAL ||--o{ CONVERSION
USUARIO ||--o{ DECISION
@enduml
