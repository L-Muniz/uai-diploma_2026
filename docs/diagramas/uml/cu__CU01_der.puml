@startuml
title cu__CU01_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "DATOS_USUARIO" as DATOS_USUARIO {
  *ID_USUARIO PK, FK
  FECHA_NACIMIENTO
  LATITUD
  LONGITUD
  LOCALIDAD
}
entity "DECLARACION_MATERIAL" as DECLARACION {
  *ID_DECLARACION PK
  ID_USUARIO FK
  ID_MATERIAL FK
  CANTIDAD
  FECHA
  ESTADO
}
entity "MATERIAL" as MATERIAL {
  *ID_MATERIAL PK
  NOMBRE
  CATEGORIA
  UNIDAD_MEDIDA
}
entity "RECOMENDACION" as RECOMENDACION {
  *ID_RECOMENDACION PK
  ID_DECLARACION FK UNIQUE
  ID_GUIA FK (nulo)
  ID_PUNTO_VERDE FK (nulo)
  TIPO_OPCION_ELEGIDA
  FECHA_GENERACION
}
entity "GUIA_REUTILIZACION" as GUIA {
  *ID_GUIA PK
  ID_MATERIAL FK
  TITULO
  PASOS
  DIFICULTAD
}
entity "PUNTO_VERDE" as PUNTO_VERDE {
  *ID_PUNTO_VERDE PK
  NOMBRE
  DIRECCION
  LATITUD
  LONGITUD
  HORARIO
  ACTIVO
}
entity "CUENTA_ECOPUNTOS" as CUENTA {
  *ID_CUENTA PK
  ID_USUARIO FK UNIQUE
  SALDO
  NIVEL
}
entity "MOVIMIENTO_ECOPUNTOS" as MOVIMIENTO {
  *ID_MOVIMIENTO PK
  ID_CUENTA FK
  TIPO
  PUNTOS
  FECHA
  MOTIVO
}
USUARIO ||--o{ DECLARACION
DECLARACION }o--|| MATERIAL
DECLARACION ||--o| RECOMENDACION
RECOMENDACION }o--o| GUIA
RECOMENDACION }o--o| PUNTO_VERDE
USUARIO ||--|| CUENTA
CUENTA ||--o{ MOVIMIENTO
MATERIAL ||--o{ GUIA
USUARIO ||--o| DATOS_USUARIO
@enduml
