@startuml
title der_negocio
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "DATOS_USUARIO" as DATOS_USUARIO {
  *ID_USUARIO PK, FK
  FECHA_NACIMIENTO
  LATITUD
  LONGITUD
  LOCALIDAD
}
entity "SUSCRIPCION_MATERIAL" as SUSC {
  *ID_USUARIO PK, FK
  *ID_MATERIAL PK, FK
  FECHA_ALTA
}
entity "VERIFICACION_VENDEDOR" as VERIFICACION {
  *ID_VERIFICACION PK
  ID_USUARIO FK
  FECHA
  ESTADO
  DOCUMENTO_REF
}
entity "MATERIAL" as MATERIAL {
  *ID_MATERIAL PK
  NOMBRE
  CATEGORIA
  UNIDAD_MEDIDA
}
entity "DECLARACION_MATERIAL" as DECLARACION {
  *ID_DECLARACION PK
  ID_USUARIO FK
  ID_MATERIAL FK
  CANTIDAD
  FECHA
  ESTADO
}
entity "RECOMENDACION" as RECOMENDACION {
  *ID_RECOMENDACION PK
  ID_DECLARACION FK UNIQUE
  ID_GUIA FK (nulo)
  ID_PUNTO_VERDE FK (nulo)
  TIPO_OPCION_ELEGIDA
  FECHA_GENERACION
}
entity "GUIA_REUTILIZACION" as GUIA {
  *ID_GUIA PK
  ID_MATERIAL FK
  TITULO
  PASOS
  DIFICULTAD
}
entity "PUNTO_VERDE" as PUNTO_VERDE {
  *ID_PUNTO_VERDE PK
  NOMBRE
  DIRECCION
  LATITUD
  LONGITUD
  HORARIO
  ACTIVO
}
entity "ACOPIO" as ACOPIO {
  *ID_ACOPIO PK
  ID_DECLARACION FK (nulo)
  ID_PUNTO_VERDE FK
  ID_MATERIAL FK
  PESO_KG
  FECHA_RECEPCION
  ESTADO
}
entity "CUENTA_ECOPUNTOS" as CUENTA {
  *ID_CUENTA PK
  ID_USUARIO FK UNIQUE
  SALDO
  NIVEL
}
entity "MOVIMIENTO_ECOPUNTOS" as MOVIMIENTO {
  *ID_MOVIMIENTO PK
  ID_CUENTA FK
  TIPO
  PUNTOS
  FECHA
  MOTIVO
}
entity "CANJE" as CANJE {
  *ID_CANJE PK
  ID_USUARIO FK
  ID_CUENTA FK
  ID_BENEFICIO FK
  PUNTOS_USADOS
  FECHA
  ESTADO
}
entity "BENEFICIO" as BENEFICIO {
  *ID_BENEFICIO PK
  TIPO
  DESCRIPCION
  PUNTOS_REQUERIDOS
  COSTO_EMPRESA
  ACTIVO
}
entity "INFORME_GESTION" as INFORME {
  *ID_INFORME PK
  ID_USUARIO FK
  TIPO
  PERIODO
  FECHA_GENERACION
}
entity "DECISION" as DECISION {
  *ID_DECISION PK
  ID_INFORME FK (nulo)
  ID_USUARIO FK
  ID_PUNTO_VERDE FK (nulo)
  TIPO
  DESCRIPCION
  FECHA
}
entity "TARIFA_COMISION" as TARIFA {
  *ID_TARIFA PK
  ID_DECISION FK (nulo)
  CATEGORIA
  PORCENTAJE
  VIGENTE_DESDE
}
entity "TABLA_CONVERSION" as CONVERSION {
  *ID_CONVERSION PK
  ID_DECISION FK (nulo)
  ID_MATERIAL FK
  PUNTOS_POR_KG
  VIGENTE_DESDE
}
entity "PRODUCTO" as PRODUCTO {
  *ID_PRODUCTO PK
  ID_VENDEDOR FK
  ID_TARIFA FK (nulo)
  NOMBRE
  DESCRIPCION
  CATEGORIA
  PRECIO
  STOCK
  ESTADO
}
entity "ORDEN_VENTA" as ORDEN {
  *ID_ORDEN PK
  ID_COMPRADOR FK
  ID_VENDEDOR FK
  FECHA
  ESTADO
  MONTO_BRUTO
  DIRECCION_ENVIO
}
entity "ORDEN_DETALLE" as ITEM {
  *ID_ORDEN PK, FK
  *ID_PRODUCTO PK, FK
  CANTIDAD
  PRECIO_UNITARIO
}
entity "PAGO" as PAGO {
  *ID_PAGO PK
  ID_ORDEN FK
  REFERENCIA_PASARELA
  MONTO
  ESTADO
  FECHA
}
entity "COMISION" as COMISION {
  *ID_COMISION PK
  ID_ORDEN FK
  PORCENTAJE
  MONTO
  FECHA
}
entity "LIQUIDACION_VENDEDOR" as LIQUIDACION {
  *ID_LIQUIDACION PK
  ID_ORDEN FK UNIQUE
  MONTO_NETO
  ESTADO
  FECHA_DISPONIBLE
  FECHA_PAGO
}
entity "RECLAMO" as RECLAMO {
  *ID_RECLAMO PK
  ID_ORDEN FK
  ID_USUARIO FK
  MOTIVO
  ESTADO
  FECHA
}
entity "PUNTO_VERDE_MATERIAL" as PVM {
  *ID_PUNTO_VERDE PK, FK
  *ID_MATERIAL PK, FK
  ACEPTADO
}
USUARIO ||--o{ DECLARACION
DECLARACION }o--|| MATERIAL
DECLARACION ||--o| RECOMENDACION
RECOMENDACION }o--o| GUIA
RECOMENDACION }o--o| PUNTO_VERDE
DECLARACION ||--o| ACOPIO
PUNTO_VERDE ||--o{ ACOPIO
MATERIAL ||--o{ ACOPIO
PUNTO_VERDE ||--o{ PVM
MATERIAL ||--o{ PVM
USUARIO ||--|| CUENTA
CUENTA ||--o{ MOVIMIENTO
USUARIO ||--o{ CANJE
BENEFICIO ||--o{ CANJE
CUENTA ||--o{ CANJE
USUARIO ||--o{ INFORME
INFORME ||--o{ DECISION
DECISION ||--o{ TARIFA
DECISION }o--o| PUNTO_VERDE
DECISION ||--o{ CONVERSION
MATERIAL ||--o{ CONVERSION
USUARIO ||--o{ DECISION
USUARIO ||--o{ VERIFICACION
USUARIO ||--o{ PRODUCTO
USUARIO ||--o{ ORDEN
USUARIO ||--o{ ORDEN
ORDEN ||--|{ ITEM
PRODUCTO ||--o{ ITEM
ORDEN ||--|{ PAGO
ORDEN ||--|| COMISION
ORDEN ||--|| LIQUIDACION
ORDEN ||--o{ RECLAMO
USUARIO ||--o{ RECLAMO
MATERIAL ||--o{ GUIA
TARIFA ||--o{ PRODUCTO
USUARIO ||--o| DATOS_USUARIO
USUARIO ||--o{ SUSC
MATERIAL ||--o{ SUSC
@enduml
