@startuml
title cu__CU15_der
entity "USUARIO" as USUARIO {
  *ID_USUARIO PK
  USERNAME
  PASS
  BLOQUEADO
  DVH_HORIZONTAL
}
entity "ORDEN_VENTA" as ORDEN {
  *ID_ORDEN PK
  ID_COMPRADOR FK
  ID_VENDEDOR FK
  FECHA
  ESTADO
  MONTO_BRUTO
  DIRECCION_ENVIO
}
entity "LIQUIDACION_VENDEDOR" as LIQUIDACION {
  *ID_LIQUIDACION PK
  ID_ORDEN FK UNIQUE
  MONTO_NETO
  ESTADO
  FECHA_DISPONIBLE
  FECHA_PAGO
}
USUARIO ||--o{ ORDEN
USUARIO ||--o{ ORDEN
ORDEN ||--|| LIQUIDACION
@enduml
