@startuml CU08
title CU08 Fijar conversión de puntos
actor "Gerencia" as ACT
boundary FormTarifas
participant BLL_GESTION
participant MP_GESTION
participant BLL_BITACORA
participant MP_BITACORA
database "SQL Server" as BD
ACT -> FormTarifas : presiona Fijar conversión
FormTarifas -> BLL_GESTION : ProponerConversion(BE_USUARIO usuario, int idMaterial, decimal puntosPorKg)
BLL_GESTION -> MP_GESTION : AltaDecision(int? idInforme, int idUsuario, int? idPuntoVerde, string tipo, string descripcion)
MP_GESTION -> BD : DECISION_ALTA
BD --> MP_GESTION : object
MP_GESTION --> BLL_GESTION : int id
BLL_GESTION -> MP_GESTION : AltaConversion(int? idDecision, int idMaterial, decimal puntosPorKg)
MP_GESTION -> BD : CONVERSION_ALTA
BD --> MP_GESTION : object
MP_GESTION --> BLL_GESTION : int id
BLL_GESTION -> BLL_BITACORA : IngresarRegistro(BE_USUARIO usuario, string descripcion)
BLL_BITACORA -> MP_BITACORA : Alta(BE_BITACORA obj)
MP_BITACORA -> BD : REGISTRO
BD --> MP_BITACORA : int
MP_BITACORA --> BLL_BITACORA : int filas
BLL_BITACORA --> BLL_GESTION : void
BLL_GESTION -> BLL_GESTION : Exigir(PROC_GESTIONAR_TARIFAS)
BLL_GESTION --> FormTarifas : int idConversion
FormTarifas -> FormTarifas : Refrescar()
FormTarifas -> BLL_GESTION : ListarTarifas()
BLL_GESTION -> MP_GESTION : ListarTarifasVigentes()
MP_GESTION -> BD : TARIFAS_LISTAR_VIGENTES
BD --> MP_GESTION : DataTable
MP_GESTION --> BLL_GESTION : DataTable dt
BLL_GESTION --> FormTarifas : DataTable dal.ListarTarifasVigentes()
FormTarifas -> BLL_GESTION : ListarConversiones()
BLL_GESTION -> MP_GESTION : ListarConversionesVigentes()
MP_GESTION -> BD : CONVERSIONES_LISTAR_VIGENTES
BD --> MP_GESTION : DataTable
MP_GESTION --> BLL_GESTION : DataTable dt
BLL_GESTION --> FormTarifas : DataTable dal.ListarConversionesVigentes()
FormTarifas --> FormTarifas : void
FormTarifas --> ACT : muestra Conversión fijada
@enduml
