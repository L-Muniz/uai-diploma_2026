@startuml CU06
title CU06 Gestionar puntos verdes
actor "Gerencia" as ACT
boundary FormPuntosVerdes
participant BLL_GESTION
participant MP_RECICLAJE
participant MP_GESTION
participant BLL_BITACORA
participant MP_BITACORA
database "SQL Server" as BD
ACT -> FormPuntosVerdes : completa datos y presiona Guardar
FormPuntosVerdes -> BLL_GESTION : GuardarPuntoVerde()
BLL_GESTION -> MP_RECICLAJE : AltaPuntoVerde()
MP_RECICLAJE -> BD : PUNTO_VERDE_ALTA
BD --> MP_RECICLAJE : resultado
MP_RECICLAJE --> BLL_GESTION : int
BLL_GESTION -> MP_RECICLAJE : ModificarPuntoVerde()
MP_RECICLAJE -> BD : PUNTO_VERDE_MODIFICAR
BD --> MP_RECICLAJE : resultado
MP_RECICLAJE --> BLL_GESTION : void
BLL_GESTION -> MP_RECICLAJE : GuardarMaterialesAceptados()
MP_RECICLAJE -> BD : PUNTO_VERDE_MATERIALES_GUARDAR
BD --> MP_RECICLAJE : resultado
MP_RECICLAJE --> BLL_GESTION : void
BLL_GESTION -> MP_GESTION : AltaDecision()
MP_GESTION -> BD : DECISION_ALTA
BD --> MP_GESTION : resultado
MP_GESTION --> BLL_GESTION : int
BLL_GESTION -> BLL_BITACORA : IngresarRegistro()
BLL_BITACORA -> MP_BITACORA : Alta()
MP_BITACORA -> BD : REGISTRO
BD --> MP_BITACORA : resultado
MP_BITACORA --> BLL_BITACORA : int
BLL_BITACORA --> BLL_GESTION : void
BLL_GESTION -> BLL_GESTION : Exigir(PROC_GESTIONAR_PUNTOS_VERDES)
BLL_GESTION --> FormPuntosVerdes : int
FormPuntosVerdes -> FormPuntosVerdes : Refrescar()
FormPuntosVerdes -> BLL_GESTION : ListarPuntosVerdes()
BLL_GESTION -> MP_RECICLAJE : ListarPuntosVerdes()
MP_RECICLAJE -> BD : PUNTO_VERDE_LISTAR
BD --> MP_RECICLAJE : resultado
MP_RECICLAJE --> BLL_GESTION : DataTable
BLL_GESTION --> FormPuntosVerdes : DataTable
FormPuntosVerdes --> FormPuntosVerdes : void
FormPuntosVerdes --> ACT : muestra Punto verde guardado
@enduml
