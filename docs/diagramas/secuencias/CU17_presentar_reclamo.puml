@startuml CU17
title CU17 Presentar reclamo
actor Comprador
participant "Interfaz (FormReclamos)" as IU
participant "BLL_MARKETPLACE" as BLL
participant "MP_MARKETPLACE" as DAL
database "Base de datos (SQL Server)" as BD
Comprador -> IU : presentar reclamo (orden, motivo)
IU -> BLL : PresentarReclamo(comprador, idOrden, motivo)
BLL -> BLL : Exigir(PROC_RECLAMAR)
BLL -> DAL : RegistrarReclamo(idOrden, idComprador, motivo)
DAL -> BD : RECLAMO_REGISTRAR
DAL --> BLL : idReclamo (liquidación CONGELADA)
BLL --> IU : reclamo registrado
@enduml
