@startuml CU15
title CU15 Confirmar recepción de pedido
actor "Comprador" as ACT
boundary FormLiquidacion
participant BLL_MARKETPLACE
participant MP_MARKETPLACE
participant BLL_BITACORA
participant MP_BITACORA
database "SQL Server" as BD
ACT -> FormLiquidacion : selecciona compra y presiona Confirmar recepción conforme
FormLiquidacion -> BLL_MARKETPLACE : ConfirmarRecepcion(BE_USUARIO comprador, int idOrden)
BLL_MARKETPLACE -> MP_MARKETPLACE : ConfirmarRecepcion(int idOrden, int idComprador)
MP_MARKETPLACE -> BD : ORDEN_CONFIRMAR_RECEPCION
BD --> MP_MARKETPLACE : int
MP_MARKETPLACE --> BLL_MARKETPLACE : void
BLL_MARKETPLACE -> BLL_BITACORA : IngresarRegistro(BE_USUARIO usuario, string descripcion)
BLL_BITACORA -> MP_BITACORA : Alta(BE_BITACORA obj)
MP_BITACORA -> BD : REGISTRO
BD --> MP_BITACORA : int
MP_BITACORA --> BLL_BITACORA : int filas
BLL_BITACORA --> BLL_MARKETPLACE : void
BLL_MARKETPLACE -> BLL_MARKETPLACE : Exigir(PROC_CONFIRMAR_RECEPCION)
BLL_MARKETPLACE --> FormLiquidacion : void
FormLiquidacion -> FormLiquidacion : IdSeleccionado(DataGridView grilla)
FormLiquidacion --> FormLiquidacion : int? grilla.CurrentRow == null ? (int?)null : Convert.ToInt32(grilla.CurrentRow.Cells["ID"].Value)
FormLiquidacion -> FormLiquidacion : Refrescar()
FormLiquidacion -> BLL_MARKETPLACE : ListarOrdenesComprador(int idComprador)
BLL_MARKETPLACE -> MP_MARKETPLACE : ListarOrdenesComprador(int idComprador)
MP_MARKETPLACE -> BD : ORDENES_COMPRADOR_LISTAR
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE --> BLL_MARKETPLACE : DataTable dt
BLL_MARKETPLACE --> FormLiquidacion : DataTable dal.ListarOrdenesComprador(idComprador)
FormLiquidacion -> BLL_MARKETPLACE : ListarOrdenesVendedor(int idVendedor)
BLL_MARKETPLACE -> MP_MARKETPLACE : ListarOrdenesVendedor(int idVendedor)
MP_MARKETPLACE -> BD : ORDENES_VENDEDOR_LISTAR
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE --> BLL_MARKETPLACE : DataTable dt
BLL_MARKETPLACE --> FormLiquidacion : DataTable dal.ListarOrdenesVendedor(idVendedor)
FormLiquidacion -> BLL_MARKETPLACE : ListarLiquidaciones(string estado)
BLL_MARKETPLACE -> MP_MARKETPLACE : ListarLiquidaciones(string estado)
MP_MARKETPLACE -> BD : LIQUIDACIONES_LISTAR
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE --> BLL_MARKETPLACE : DataTable dt
BLL_MARKETPLACE --> FormLiquidacion : DataTable dal.ListarLiquidaciones(estado)
FormLiquidacion -> BLL_MARKETPLACE : ListarLiquidacionesDeVendedor(int idVendedor)
BLL_MARKETPLACE -> MP_MARKETPLACE : ListarLiquidacionesDeVendedor(int idVendedor)
MP_MARKETPLACE -> BD : LIQUIDACIONES_VENDEDOR_LISTAR
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE --> BLL_MARKETPLACE : DataTable dt
BLL_MARKETPLACE --> FormLiquidacion : DataTable dal.ListarLiquidacionesDeVendedor(idVendedor)
FormLiquidacion --> FormLiquidacion : void
FormLiquidacion --> ACT : muestra Recepción confirmada
@enduml
