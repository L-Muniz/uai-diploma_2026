@startuml CU11
title CU11 Publicar producto
actor Vendedor
participant "FormPublicarProducto" as IU
participant "BLL_MARKETPLACE" as BLL
participant "BLL_GESTION" as GES
participant "MP_MARKETPLACE" as DAL
Vendedor -> IU : publicar (nombre, categoría, precio, stock)
IU -> BLL : PublicarProducto(vendedor, nombre, descripcion, categoria, precio, stock)
BLL -> BLL : Exigir(PROC_PUBLICAR_PRODUCTO) y EsVendedorVerificado()
BLL -> GES : ObtenerIdTarifaVigente(categoria)
BLL -> DAL : AltaProducto(producto) (queda PENDIENTE)
BLL --> IU : producto pendiente de aprobación
@enduml
