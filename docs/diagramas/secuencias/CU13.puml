@startuml CU13
title CU13 Comprar producto
actor "Comprador" as ACT
boundary FormCompraMarketplace
participant BLL_MARKETPLACE
participant IPasarelaPago
participant MP_MARKETPLACE
participant BLL_BITACORA
participant MP_BITACORA
participant MP_GESTION
database "SQL Server" as BD
ACT -> FormCompraMarketplace : selecciona producto, cantidad y domicilio, presiona Pagar pedido y confirma Sí
FormCompraMarketplace -> BLL_MARKETPLACE : Comprar(BE_USUARIO comprador, int idProducto, int cantidad, string direccion, IPasarelaPago pasarela)
BLL_MARKETPLACE -> MP_MARKETPLACE : ObtenerProducto(int idProducto)
MP_MARKETPLACE -> BD : PRODUCTO_OBTENER
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE -> BD : ID_PRODUCTO
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE -> BD : ID_VENDEDOR
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE -> BD : ID_TARIFA
BD --> MP_MARKETPLACE : DataTable
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE -> BD : NOMBRE
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE -> BD : DESCRIPCION
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE -> BD : CATEGORIA
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE -> BD : PRECIO
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE -> BD : STOCK
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE -> BD : ESTADO
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE --> BLL_MARKETPLACE : BE_Producto null
BLL_MARKETPLACE -> BLL_BITACORA : IngresarRegistro(BE_USUARIO usuario, string descripcion)
BLL_BITACORA -> MP_BITACORA : Alta(BE_BITACORA obj)
MP_BITACORA -> BD : REGISTRO
BD --> MP_BITACORA : int
MP_BITACORA --> BLL_BITACORA : int filas
BLL_BITACORA --> BLL_MARKETPLACE : void
BLL_MARKETPLACE -> MP_MARKETPLACE : RegistrarVentaAprobada(BE_ItemOrden item, int idComprador, int idVendedor, string direccion, string referenciaPasarela, decimal porcentajeComision)
MP_MARKETPLACE -> BD : VENTA_REGISTRAR
BD --> MP_MARKETPLACE : object
MP_MARKETPLACE --> BLL_MARKETPLACE : int id
BLL_MARKETPLACE -> BLL_BITACORA : IngresarRegistro(BE_USUARIO usuario, string descripcion)
BLL_BITACORA --> BLL_MARKETPLACE : void
BLL_MARKETPLACE -> BLL_MARKETPLACE : ObtenerComisionEstimada(string categoria)
BLL_MARKETPLACE -> MP_GESTION : ObtenerPorcentajeVigente(string categoria)
MP_GESTION -> BD : TARIFA_PORCENTAJE_VIGENTE
BD --> MP_GESTION : object
MP_GESTION --> BLL_MARKETPLACE : decimal? null
BLL_MARKETPLACE -> MP_GESTION : ObtenerPorcentajeVigente(string categoria)
MP_GESTION --> BLL_MARKETPLACE : decimal? null
BLL_MARKETPLACE --> BLL_MARKETPLACE : decimal dalGestion.ObtenerPorcentajeVigente(categoria) ?? dalGestion.ObtenerPorcentajeVigente("General") ?? 0m
BLL_MARKETPLACE -> BLL_MARKETPLACE : Exigir(PROC_COMPRAR)
BLL_MARKETPLACE --> FormCompraMarketplace : int idOrden
FormCompraMarketplace -> BLL_MARKETPLACE : ListarCatalogo()
BLL_MARKETPLACE -> MP_MARKETPLACE : ListarCatalogo()
MP_MARKETPLACE -> BD : CATALOGO_LISTAR
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE --> BLL_MARKETPLACE : DataTable dt
BLL_MARKETPLACE --> FormCompraMarketplace : DataTable dal.ListarCatalogo()
FormCompraMarketplace -> FormCompraMarketplace : ActualizarResumen()
FormCompraMarketplace --> FormCompraMarketplace : >
FormCompraMarketplace --> ACT : muestra Pago aprobado y número de orden
@enduml
