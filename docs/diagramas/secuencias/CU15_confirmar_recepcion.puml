@startuml CU15
title CU15 Confirmar recepción de pedido
actor Comprador
participant "FormLiquidacion" as IU
participant "BLL_MARKETPLACE" as BLL
participant "MP_MARKETPLACE" as DAL
Comprador -> IU : confirmar recepción (orden)
IU -> BLL : ConfirmarRecepcion(comprador, idOrden)
BLL -> BLL : Exigir(PROC_CONFIRMAR_RECEPCION)
BLL -> DAL : ConfirmarRecepcion(idOrden, idComprador)
DAL --> BLL : orden RECIBIDA y liquidación DISPONIBLE
BLL --> IU : recepción confirmada
@enduml
