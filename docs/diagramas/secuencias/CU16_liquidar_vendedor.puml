@startuml CU16
title CU16 Liquidar vendedor
actor "Área comercial" as Area
participant "Interfaz (FormLiquidacion)" as IU
participant "BLL_MARKETPLACE" as BLL
participant "MP_MARKETPLACE" as DAL
database "Base de datos (SQL Server)" as BD
Area -> IU : pagar liquidación (idLiquidacion)
IU -> BLL : PagarLiquidacion(responsable, idLiquidacion)
BLL -> BLL : Exigir(PROC_LIQUIDAR)
BLL -> DAL : PagarLiquidacion(idLiquidacion)
DAL -> BD : LIQUIDACION_PAGAR
DAL --> BLL : DISPONIBLE pasa a PAGADA
BLL --> IU : transferencia ordenada
@enduml
