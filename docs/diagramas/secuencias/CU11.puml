@startuml CU11
title CU11 Publicar producto
actor "Vendedor verificado" as ACT
boundary FormPublicarProducto
participant BLL_MARKETPLACE
participant MP_GESTION
participant MP_MARKETPLACE
participant BLL_BITACORA
participant MP_BITACORA
database "SQL Server" as BD
ACT -> FormPublicarProducto : completa datos y presiona Publicar
FormPublicarProducto -> BLL_MARKETPLACE : PublicarProducto(BE_USUARIO vendedor, string nombre, string descripcion, string categoria, decimal precio, int stock)
BLL_MARKETPLACE -> MP_GESTION : ObtenerIdTarifaVigente(string categoria)
MP_GESTION -> BD : TARIFA_ID_VIGENTE
BD --> MP_GESTION : object
MP_GESTION --> BLL_MARKETPLACE : int? null
BLL_MARKETPLACE -> MP_GESTION : ObtenerIdTarifaVigente(string categoria)
MP_GESTION --> BLL_MARKETPLACE : int? null
BLL_MARKETPLACE -> MP_MARKETPLACE : AltaProducto(BE_Producto producto)
MP_MARKETPLACE -> BD : PRODUCTO_ALTA
BD --> MP_MARKETPLACE : object
MP_MARKETPLACE --> BLL_MARKETPLACE : int id
BLL_MARKETPLACE -> BLL_BITACORA : IngresarRegistro(BE_USUARIO usuario, string descripcion)
BLL_BITACORA -> MP_BITACORA : Alta(BE_BITACORA obj)
MP_BITACORA -> BD : REGISTRO
BD --> MP_BITACORA : int
MP_BITACORA --> BLL_BITACORA : int filas
BLL_BITACORA --> BLL_MARKETPLACE : void
BLL_MARKETPLACE -> BLL_MARKETPLACE : EsVendedorVerificado(int idUsuario)
BLL_MARKETPLACE -> MP_MARKETPLACE : UltimoEstadoVerificacion(int idUsuario)
MP_MARKETPLACE -> BD : VERIFICACION_ULTIMO_ESTADO
BD --> MP_MARKETPLACE : object
MP_MARKETPLACE --> BLL_MARKETPLACE : string o == null || o == DBNull.Value ? null : o.ToString()
BLL_MARKETPLACE --> BLL_MARKETPLACE : bool dal.UltimoEstadoVerificacion(idUsuario) == "APROBADA"
BLL_MARKETPLACE -> BLL_MARKETPLACE : Exigir(PROC_PUBLICAR_PRODUCTO)
BLL_MARKETPLACE --> FormPublicarProducto : int id
FormPublicarProducto -> FormPublicarProducto : Refrescar()
FormPublicarProducto -> BLL_MARKETPLACE : ListarProductosDeVendedor(int idVendedor)
BLL_MARKETPLACE -> MP_MARKETPLACE : ListarProductosDeVendedor(int idVendedor)
MP_MARKETPLACE -> BD : PRODUCTOS_VENDEDOR_LISTAR
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE --> BLL_MARKETPLACE : DataTable dt
BLL_MARKETPLACE --> FormPublicarProducto : DataTable dal.ListarProductosDeVendedor(idVendedor)
FormPublicarProducto -> BLL_MARKETPLACE : ListarProductosPendientes()
BLL_MARKETPLACE -> MP_MARKETPLACE : ListarProductosPendientes()
MP_MARKETPLACE -> BD : PRODUCTOS_PENDIENTES_LISTAR
BD --> MP_MARKETPLACE : DataTable
MP_MARKETPLACE --> BLL_MARKETPLACE : DataTable dt
BLL_MARKETPLACE --> FormPublicarProducto : DataTable dal.ListarProductosPendientes()
FormPublicarProducto --> FormPublicarProducto : void
FormPublicarProducto --> ACT : muestra Producto publicado
@enduml
