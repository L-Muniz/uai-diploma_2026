@startuml CU01
title CU01 Declarar material
actor Ciudadano
participant "Interfaz (FormDeclararMaterial)" as IU
participant "BLL_RECICLAJE" as BLL
participant "MP_RECICLAJE" as DAL
participant "BLL_ECOPUNTOS" as EP
database "Base de datos (SQL Server)" as BD
Ciudadano -> IU : declarar(material, cantidad)
IU -> BLL : DeclararMaterial(usuario, idMaterial, cantidad)
BLL -> DAL : AltaDeclaracion(idUsuario, idMaterial, cantidad)
DAL -> BD : DECLARACION_ALTA
DAL --> BLL : idDeclaracion
BLL -> DAL : ListarGuiasPorMaterial(idMaterial)
DAL -> BD : GUIA_LISTAR_POR_MATERIAL
BLL -> DAL : ListarPuntosVerdesPorMaterial(idMaterial)
DAL -> BD : PUNTO_VERDE_LISTAR_POR_MATERIAL
BLL -> BLL : MasCercano(usuario, puntos)
BLL --> IU : OpcionesRecomendacion
alt reutilizar en casa
  Ciudadano -> IU : confirmar reutilización
  IU -> BLL : ConfirmarReutilizacion(usuario, opciones)
  BLL -> DAL : GuardarRecomendacion(REUTILIZAR, REUTILIZADA)
DAL -> BD : RECOMENDACION_GUARDAR
  BLL -> EP : Acreditar(idUsuario, puntos, RECICLAJE)
else entregar en punto verde
  Ciudadano -> IU : elegir entrega oficial
  IU -> BLL : ElegirEntregaOficial(usuario, opciones)
  BLL -> DAL : GuardarRecomendacion(ENTREGA, PENDIENTE_ENTREGA)
DAL -> BD : RECOMENDACION_GUARDAR
end
@enduml
