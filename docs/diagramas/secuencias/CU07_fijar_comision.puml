@startuml CU07
title CU07 Fijar comisión por categoría
actor Gerencia
participant "Interfaz (FormTarifas)" as IU
participant "BLL_GESTION" as BLL
participant "MP_GESTION" as DAL
database "Base de datos (SQL Server)" as BD
Gerencia -> IU : fijar comisión (categoría, porcentaje)
IU -> BLL : ProponerTarifa(usuario, categoria, porcentaje)
BLL -> BLL : Exigir(PROC_GESTIONAR_TARIFAS)
BLL -> DAL : AltaDecision(null, usuario, null, CAMBIO_TARIFA)
DAL -> BD : DECISION_ALTA
DAL --> BLL : idDecision
BLL -> DAL : AltaTarifa(idDecision, categoria, porcentaje)
DAL -> BD : TARIFA_ALTA
BLL --> IU : tarifa vigente desde hoy
@enduml
