@startuml CU14
title CU14 Despachar pedido
actor Vendedor
boundary "FormLiquidacion" as IU
participant "BLL_MARKETPLACE" as BLL
participant "MP_MARKETPLACE" as DAL
database "SQL Server" as BD
Vendedor -> IU : marcar despachada (orden)
IU -> BLL : MarcarDespachada(vendedor, idOrden)
BLL -> BLL : Exigir(PROC_DESPACHAR)
BLL -> DAL : MarcarDespachada(idOrden, idVendedor)
DAL -> BD : ORDEN_DESPACHAR
BLL --> IU : orden despachada
@enduml
