@startuml CU08
title CU08 Fijar conversión de puntos
actor Gerencia
boundary "FormTarifas" as IU
participant "BLL_GESTION" as BLL
participant "MP_GESTION" as DAL
database "SQL Server" as BD
Gerencia -> IU : fijar conversión (material, puntos por kg)
IU -> BLL : ProponerConversion(usuario, idMaterial, puntosPorKg)
BLL -> BLL : Exigir(PROC_GESTIONAR_TARIFAS)
BLL -> DAL : AltaDecision(null, usuario, null, CAMBIO_CONVERSION)
DAL -> BD : DECISION_ALTA
DAL --> BLL : idDecision
BLL -> DAL : AltaConversion(idDecision, idMaterial, puntosPorKg)
DAL -> BD : CONVERSION_ALTA
BLL --> IU : conversión vigente desde hoy
@enduml
