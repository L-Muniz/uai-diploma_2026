@startuml CU04
title CU04 Consultar indicadores
actor "Gerencia" as ACT
boundary FormIndicadores
participant BLL_GESTION
participant MP_GESTION
participant BLL_BITACORA
participant MP_BITACORA
database "SQL Server" as BD
ACT -> FormIndicadores : escribe período y presiona Consultar indicadores
FormIndicadores -> BLL_GESTION : ConsultarIndicadores(BE_USUARIO usuario, string periodo)
BLL_GESTION -> MP_GESTION : IndicadorAcopioPorMaterial(string periodo)
MP_GESTION -> BD : INDICADOR_ACOPIO_POR_MATERIAL
BD --> MP_GESTION : DataTable
MP_GESTION --> BLL_GESTION : DataTable dt
BLL_GESTION -> MP_GESTION : IndicadorVentas(string periodo)
MP_GESTION -> BD : INDICADOR_VENTAS
BD --> MP_GESTION : DataTable
MP_GESTION --> BLL_GESTION : DataTable dt
BLL_GESTION -> MP_GESTION : IndicadorCostoCanjes(string periodo)
MP_GESTION -> BD : INDICADOR_COSTO_CANJES
BD --> MP_GESTION : object
MP_GESTION --> BLL_GESTION : decimal Convert.ToDecimal(o)
BLL_GESTION -> MP_GESTION : AltaInforme(int idUsuario, string tipo, string periodo)
MP_GESTION -> BD : INFORME_ALTA
BD --> MP_GESTION : object
MP_GESTION --> BLL_GESTION : int id
BLL_GESTION -> BLL_BITACORA : IngresarRegistro(BE_USUARIO usuario, string descripcion)
BLL_BITACORA -> MP_BITACORA : Alta(BE_BITACORA obj)
MP_BITACORA -> BD : REGISTRO
BD --> MP_BITACORA : int
MP_BITACORA --> BLL_BITACORA : int filas
BLL_BITACORA --> BLL_GESTION : void
BLL_GESTION -> BLL_GESTION : Exigir(PROC_VER_INDICADORES)
BLL_GESTION --> FormIndicadores : DataTable resultado
FormIndicadores --> ACT : muestra grilla de indicadores
@enduml
