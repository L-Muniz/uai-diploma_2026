@startuml CU18
title CU18 Resolver reclamo
actor "Área comercial" as Area
boundary "FormReclamos" as IU
participant "BLL_MARKETPLACE" as BLL
participant "MP_MARKETPLACE" as DAL
database "SQL Server" as BD
Area -> IU : resolver (idReclamo, procedente)
IU -> BLL : ResolverReclamo(responsable, idReclamo, procedente)
BLL -> BLL : Exigir(PROC_RESOLVER_RECLAMO)
BLL -> DAL : ResolverReclamo(idReclamo, procedente)
DAL -> BD : RECLAMO_RESOLVER
alt procedente
  DAL --> BLL : devuelve la orden, restituye stock y cancela la liquidación
else improcedente
  DAL --> BLL : libera la orden y vuelve la liquidación a RETENIDA
end
BLL --> IU : reclamo resuelto
@enduml
