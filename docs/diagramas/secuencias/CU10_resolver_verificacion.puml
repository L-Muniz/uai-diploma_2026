@startuml CU10
title CU10 Resolver verificación de vendedor
actor "Área comercial" as Area
participant "Interfaz (FormVerificacionVendedor)" as IU
participant "BLL_MARKETPLACE" as BLL
participant "MP_MARKETPLACE" as DAL
database "Base de datos (SQL Server)" as BD
Area -> IU : aprobar o rechazar (solicitante)
IU -> BLL : ResolverVerificacion(responsable, idSolicitante, aprobada)
BLL -> BLL : Exigir(PROC_RESOLVER_VERIFICACION)
BLL -> DAL : AltaVerificacion(idSolicitante, APROBADA o RECHAZADA)
DAL -> BD : VERIFICACION_ALTA
BLL --> IU : estado actualizado
@enduml
