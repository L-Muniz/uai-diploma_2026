@startuml CAPA_SERVICE
title Capa SERVICE - Diagrama de clases
skinparam classAttributeIconSize 0
skinparam linetype ortho

class SV_DigitoVerificadorHorizontal {
  - MODULO : int
  --
  + CalcularDV(string datos) : int
  + VerificarDV(string datos, int dvAlmacenado) : bool
  + ObtenerDVString(string datos) : string
}

class SV_DigitoVerificadorVertical {
  - MODULO : int
  --
  + CalcularDVAtributo(string valorAtributo, int posicionAtributo) : int
  + VerificarDVAtributo(string valorAtributo, int posicionAtributo, int dvAlmacenado) : bool
  + CalcularDVVEntidad(Dictionary<string, string> atributos) : Dictionary<string, int>
  + VerificarDVVEntidad(Dictionary<string, string> atributos, Dictionary<string, int> dvvAlmacenados) : bool
}

class SV_Encriptacion <<static>> {
  - Prefijo : string
  - Salt : byte[]
  --
  + Encriptar(string textoPlano) : string
  + Desencriptar(string textoEncriptado) : string
  + EstaEncriptado(string texto) : bool
  + EncriptarArchivo(string rutaArchivo) : void
  + LeerArchivoDesencriptado(string rutaArchivo) : string
}

class SV_Hash {
  - HashBytesLength : int
  --
  + HashPassword(string password) : string
  + EsHashValido(string storedHash) : bool
  + VerifyPassword(string password, string storedHash) : bool
}

class ISV_ProveedorTraduccion <<interface>> {
}

class SV_IdiomaManager {
  - instancia : SV_IdiomaManager
  - codigoIdiomaActual : string
  - observadores : List<ISV_IdiomaObserver>
  - proveedorTraduccion : ISV_ProveedorTraduccion
  --
  + GetInstance() : SV_IdiomaManager
  + EstablecerProveedorTraduccion(ISV_ProveedorTraduccion proveedor) : void
  + ObtenerIdiomaActual() : string
  + ObtenerIdiomasSoportados() : List<string>
  + ObtenerNombresIdiomas() : Dictionary<string, string>
  + CambiarIdioma(string codigoIdioma) : void
  + Obtener(string clave) : string
  + Obtener(string clave, params object[] args) : string
  + RegistrarObservador(ISV_IdiomaObserver observador) : void
  + DesregistrarObservador(ISV_IdiomaObserver observador) : void
  + ContarObservadores() : int
}

class ISV_IdiomaObserver <<interface>> {
}

abstract class SV_IdiomaObserverBase {
  # nombreObservador : string
  --
  + SV_IdiomaObserverBase(string nombre)
  + ActualizarIdioma(string codigoIdiomaAnterior, string codigoIdiomaNuevo) : void
  + ObtenerNombre() : string
}

class SV_Mensajes {
  - idiomaManager : SV_IdiomaManager
  --
  + GetLoginMessage() : string
  + GetLogoutMessage() : string
  + GetNewUserMessage() : string
  + GetUsuarioBloqueadoMessage() : string
  + GetIntegridadNoDisponibleMessage() : string
  + GetIntentoFallidoMessage(int intento, int intentosMaximos) : string
  + GetUsuarioBloqueadoPorIntentosMessage() : string
  + GetErrorIntegridadDatos() : string
  + GetErrorIntegridadDVH() : string
  + GetErrorIntegridadDVV() : string
  + GetVerificacionIntegridadExitosa() : string
  + Obtener(string clave) : string
  + Obtener(string clave, params object[] args) : string
}

class SV_PerfilComposite {
  + ConstructorArbolPerfiles(List<BE_Perfil> perfilesPlanos) : List<BE_Perfil>
  + VisualizarArbolPerfiles(List<BE_Perfil> raices) : string
  + ObtenerRutaPerfil(BE_Perfil perfil) : string
  + ContarPermisosEnArbol(List<BE_Perfil> raices) : int
  + BuscarPerfilPorNombre(List<BE_Perfil> raices, string nombre) : BE_Perfil
  + ObtenerTodosLosPerfiles(List<BE_Perfil> raices) : List<BE_Perfil>
  + ObtenerProfundidadMaxima(List<BE_Perfil> raices) : int
  + ObtenerEstadisticasArbol(List<BE_Perfil> raices) : Dictionary<string, object>
}

class SV_Singleton {
  - singleton : SV_Singleton
  - usuario : BE_USUARIO
  --
  + GetInstance() : SV_Singleton
  + LimpiarSesion() : void
}

SV_IdiomaManager --> ISV_ProveedorTraduccion
SV_IdiomaObserverBase --|> ISV_IdiomaObserver
SV_Mensajes --> SV_IdiomaManager
@enduml
