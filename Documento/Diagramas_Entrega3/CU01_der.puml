@startuml CU01_der
title CU-001 Iniciar Sesión - Modelo entidad-relación (ProyectoC)
hide circle
skinparam linetype ortho

entity "USUARIO" as USUARIO {
  *ID_USUARIO : int <<PK>>
  --
  USERNAME : varchar(50)
  PASS : varchar(255)
  BLOQUEADO : bit
  DVH_HORIZONTAL : int
  CODIGO_IDIOMA : nvarchar(5)
}
entity "USUARIO_ROL" as USUARIO_ROL {
  *ID_USUARIO : int <<PK, FK>>
  *ID_ROL : int <<PK, FK>>
}
entity "ROL" as ROL {
  *ID_ROL : int <<PK>>
  --
  NOMBRE : varchar(50)
  DESCRIPCION : varchar(255)
  ACTIVO : bit
  ID_ROL_PADRE : int
}
entity "BITACORA" as BITACORA {
  *ID_BITACORA : int <<PK>>
  --
  ID_USUARIO : int <<FK>>
  DESCRIPCION : varchar(50)
  FECHA : datetime
}
entity "DIGITO_VERIFICADOR_VERTICAL" as DVV {
  *ID_DVV : int <<PK>>
  --
  ID_ENTIDAD : int
  TIPO_ENTIDAD : varchar(50)
  DV_USERNAME : int
  DV_PASSWORD : int
  DV_BLOQUEADO : int
  FECHA_CREACION : datetime
}
entity "IDIOMA" as IDIOMA {
  *ID_IDIOMA : int <<PK>>
  --
  CODIGO : varchar(10)
  NOMBRE : varchar(100)
  ACTIVO : bit
}

USUARIO ||--o{ USUARIO_ROL
ROL ||--o{ USUARIO_ROL
USUARIO ||--o{ BITACORA
USUARIO |o..o{ DVV
USUARIO }o..|| IDIOMA
@enduml
