@startuml CU08_clases
title CU-008 Asignar Permiso - Diagrama de clases
skinparam classAttributeIconSize 0
skinparam linetype ortho
left to right direction

package "GUI" {
  class FormRoles {
    -AgregarComponente() : void
    -DesasignarComponente() : void
    -CargarRoles() : void
    -CargarComponentes(int idRol) : void
  }
}

package "BLL" {
  class BLL_ROL {
    +ObtenerTodosLosRoles() : List<BE_Rol>
    +ObtenerComponentesDelRol(int idRol) : List<BE_ComponenteAcceso>
    +AsignarComponente(int idRol, BE_ComponenteAcceso componente) : void
    -AgregarPermisoAlRol(int idRol, int idPermiso) : void
    +CrearMemento(int idRol) : BE_MementoRol
    -ObtenerComponentesRecursivos(int idPadre) : void
  }
  class BLL_PERMISO {
    +ObtenerComponentes(int idPermisoCompuesto) : List<BE_Permiso>
  }
  class BLL_ControlCambios <<static>> {
    +RegistrarMementoRol(BE_MementoRol anterior, BE_MementoRol despues, BE_USUARIO usuario, string descripcion) : void
  }
  class BLL_BITACORA {
    +IngresarRegistro(BE_USUARIO usuario, string descripcion) : void
  }
}

package "DAL" {
  abstract class "MAPPER<T>" as MAPPER {
    +{abstract} Alta(T obj) : int
    +{abstract} Editar(T obj) : int
  }
  class MP_ROL {
    +ListarTodos() : List<BE_Rol>
    +ObtenerPermisos(int idRol) : List<BE_Permiso>
    +AgregarPermiso(int idRol, int idPermiso) : void
  }
  class MP_PERMISO {
    +ObtenerComponentes(int idPermisoCompuesto) : List<BE_Permiso>
  }
  class MP_CambiosEntidad {
    +Alta(BE_CambiosEntidad obj) : int
  }
  class MP_BITACORA {
    +Alta(BE_BITACORA obj) : int
  }
}

package "BE" {
  class BE_Rol {
    +ID : int
    +Nombre : string
    +Descripcion : string
  }
  class BE_Permiso {
    +ID : int
    +Codigo : string
    +Nombre : string
    +EsCompuesto : bool
  }
  class BE_ComponenteAcceso {
    +ID : int
    +Tipo : string
    +EsHeredado : bool
    +Origen : string
  }
  class BE_MementoRol {
    +ID : int
    +Nombre : string
    +Descripcion : string
    +IdsPermisos : List<int>
    +ToSerializedString() : string
  }
}

FormRoles --> BLL_ROL
BLL_ROL --> BLL_PERMISO
BLL_ROL --> BLL_ControlCambios
BLL_ROL --> BLL_BITACORA
BLL_ROL --> MP_ROL
BLL_PERMISO --> MP_PERMISO
BLL_ControlCambios --> MP_CambiosEntidad
BLL_BITACORA --> MP_BITACORA
MP_ROL --> BE_Rol
MP_ROL --> BE_Permiso
MP_PERMISO --> BE_Permiso
BLL_ROL --> BE_ComponenteAcceso
BLL_ROL --> BE_MementoRol
MP_ROL --|> MAPPER
MP_CambiosEntidad --|> MAPPER
MP_BITACORA --|> MAPPER
@enduml
