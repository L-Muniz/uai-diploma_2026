@startuml CU09_secuencia
title CU-009 Desasignar Permiso
actor "Administrador" as ACT
boundary FormRoles
participant BLL_ROL
participant MP_ROL
participant BLL_ControlCambios
participant MP_CambiosEntidad
participant BLL_BITACORA
participant MP_BITACORA
database "ProyectoC" as BD

ACT -> FormRoles : selecciona Administración > Roles y un rol
FormRoles -> BLL_ROL : ObtenerComponentesDelRol(int idRol) : List<BE_ComponenteAcceso>
BLL_ROL --> FormRoles : List<BE_ComponenteAcceso>
FormRoles --> ACT : muestra los componentes del rol
ACT -> FormRoles : selecciona un permiso y pulsa Quitar
FormRoles -> BLL_ROL : DesasignarComponente(int idRol, BE_ComponenteAcceso componente) : void
alt Componente heredado de un compuesto (EsHeredado = true)
  BLL_ROL --> FormRoles : throw InvalidOperationException("Solo se pueden quitar permisos asignados directamente al rol.")
  FormRoles --> ACT : MessageBox de error, no realiza cambios
else Permiso asignado directamente
  BLL_ROL -> BLL_ROL : QuitarPermisoDelRol(int idRol, int idPermiso) : void
  BLL_ROL -> BLL_ROL : CrearMemento(int idRol) : BE_MementoRol
  BLL_ROL -> MP_ROL : QuitarPermiso(int idRol, int idPermiso) : void
  MP_ROL -> BD : ROL_QUITAR_PERMISO
  BD --> MP_ROL : void
  MP_ROL --> BLL_ROL : void
  BLL_ROL -> BLL_ROL : CrearMemento(int idRol) : BE_MementoRol
  BLL_ROL -> BLL_ControlCambios : RegistrarMementoRol(BE_MementoRol anterior, BE_MementoRol despues, BE_USUARIO usuario, string descripcion) : void
  BLL_ControlCambios -> MP_CambiosEntidad : Alta(BE_CambiosEntidad cambio) : int
  MP_CambiosEntidad -> BD : CAMBIOS_ENTIDAD_ALTA
  BD --> MP_CambiosEntidad : int filas
  MP_CambiosEntidad --> BLL_ControlCambios : int filas
  BLL_ROL -> BLL_BITACORA : IngresarRegistro(BE_USUARIO usuario, string "Permiso quitado del rol ID ...") : void
  BLL_BITACORA -> MP_BITACORA : Alta(BE_BITACORA obj) : int
  MP_BITACORA -> BD : REGISTRO
  BD --> MP_BITACORA : int filas
  MP_BITACORA --> BLL_BITACORA : int filas
  BLL_BITACORA --> BLL_ROL : void
  BLL_ROL --> FormRoles : void
  FormRoles -> FormRoles : CargarRoles() : void
  FormRoles --> ACT : actualiza la grilla de componentes
end
@enduml
